@echo off
setlocal
set "UNIFIED_RELAY_PREVIEW=%~f0"
powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -Command "$self=[Environment]::GetEnvironmentVariable('UNIFIED_RELAY_PREVIEW'); $lines=[System.IO.File]::ReadAllLines($self); $marker=[Array]::IndexOf($lines,'::UNIFIED_RELAY_PREVIEW_PAYLOAD::'); if($marker -lt 0){throw 'Preview payload is missing.'}; $data=[string]::Concat([string[]]$lines[($marker+1)..($lines.Length-1)]); Invoke-Expression ([System.Text.Encoding]::UTF8.GetString([System.Convert]::FromBase64String($data)))"
exit /b %ERRORLEVEL%
::UNIFIED_RELAY_PREVIEW_PAYLOAD::


